{
  "name": "breakhound",
  "version": "1.0.0",
  "description": "Finds bugs in JavaScript and TypeScript libraries by running every exported function on edge case inputs.",
  "keywords": [
    "testing",
    "edge-cases",
    "fuzzing",
    "invariants",
    "typescript",
    "unicode",
    "timezone",
    "cli"
  ],
  "homepage": "https://kwy404.github.io/breakhound/",
  "bugs": {
    "url": "https://github.com/kwy404/breakhound/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwy404/breakhound.git"
  },
  "license": "MIT",
  "author": "Alexandre Kohler (https://github.com/kwy404)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "breakhound": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixture": "node scripts/build-fixture.mjs",
    "docs": "node scripts/build-docs.mjs",
    "demo": "node scripts/build-demo.mjs",
    "prepublishOnly": "npm run build && npm test",
    "pretest": "node scripts/build-fixture.mjs",
    "docs:check": "node scripts/build-docs.mjs --check"
  },
  "dependencies": {
    "edgegoat": "^0.1.0",
    "typescript": "~5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "shiki": "^3.23.0",
    "tsup": "^8.5.1",
    "typescript-eslint": "^8.71.2",
    "vite": "^6.4.4",
    "vitest": "^3.2.7"
  }
}
